# Copy to .env.local in this folder (git-ignored). Razorpay TEST-mode credentials only:
# Dashboard > switch to Test Mode > Account & Settings > API Keys.
# The server refuses any key that does not start with rzp_test_.
RAZORPAY_TEST_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_TEST_KEY_SECRET=

# Optional: an existing test-mode plan (plan_XXXXXXXX). If empty, the spike creates a
# ₹588.82/month test plan (₹499 + 18% GST) the first time you create a subscription.
RAZORPAY_TEST_PLAN_ID=
